# Datenbank – für lokale Entwicklung reicht SQLite, für Produktion Postgres
# Lokal (SQLite):   sqlite:///./chimaera.db
# Neon (Postgres):  postgresql://user:pass@ep-xxx.region.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///./chimaera.db

# Admin-Zugang – WICHTIG: für Produktion ändern!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Session-Signatur – irgendein langer Zufallsstring, z.B. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-this-to-a-long-random-string-in-production

# Festival-Name (wird in Formular + Mails eingesetzt)
FESTIVAL_NAME=Chimaera Festival

# --- Direkt-Anmeldung (Schicht-zuerst-Flow auf "/") ---
# Eigener Schalter, getrennt vom klassischen Anmeldeformular (REGISTRATION_OPEN)
# und vom eingeloggten Self-Signup (SHIFT_SIGNUP_OPEN). Ist DIRECT_SIGNUP_OPEN=true
# (oder die Zeitsteuerung erreicht), zeigt "/" den dreistufigen Direkt-Flow:
# 1. Schicht(en) wählen  2. Name/Email/Handy  3. Kautions-Frage -> danach /me.
DIRECT_SIGNUP_OPEN=false
# Optional: automatische Freischaltung zu einem Zeitpunkt (ISO-8601 mit Zeitzone).
# Beispiel Berlin-Sommerzeit: 2026-08-07T16:00:00+02:00
DIRECT_SIGNUP_OPEN_AT=
# Geheimes Token für die interne Vorschau. Aufruf: /vorschau?key=<TOKEN>
# Leer = Vorschau aus. Beispiel-Token erzeugen: python -c "import secrets; print(secrets.token_urlsafe(16))"
DIRECT_SIGNUP_PREVIEW_TOKEN=
# Anzeige-Beträge im Direkt-Flow
DEPOSIT_AMOUNT_EUR=160
ONE_SHIFT_PRICE_EUR=75

# Anforderungen für Helfer:in-Status (nur zur Anzeige im Formular)
MIN_SHIFTS=2
MIN_DAYS=2
BENEFITS_MIN_SHIFTS=3
BENEFITS_MIN_DAYS=3

# SMTP – optional. Wenn leer, wird Mail-Versand deaktiviert und nur Copy/CSV angeboten
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=helfer@chimaera-festival.de
SMTP_FROM_NAME=Chimaera Helfer-Team
SMTP_USE_TLS=true

# Dev-Flag: zeigt den Passwort-Reset-Link direkt auf der Seite an, wenn SMTP
# nicht konfiguriert ist. NUR in der lokalen Entwicklung auf true stellen!
DEBUG_SHOW_RESET_LINK=false
